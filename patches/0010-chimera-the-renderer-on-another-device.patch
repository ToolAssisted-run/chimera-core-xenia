+void VulkanCommandProcessor::ChimeraLeaveDevice() {
+  using ui::vulkan::LinkedTypeDescriptorSetAllocator;
+  using ui::vulkan::VulkanGPUCompletionTimeline;
+  transient_descriptor_allocator_textures_.~LinkedTypeDescriptorSetAllocator();
+  transient_descriptor_allocator_storage_buffer_
+      .~LinkedTypeDescriptorSetAllocator();
+  transient_descriptor_allocator_uniform_buffer_
+      .~LinkedTypeDescriptorSetAllocator();
+  completion_timeline_.~VulkanGPUCompletionTimeline();
+}
+
+void VulkanCommandProcessor::ChimeraEnterDevice() {
+  ui::vulkan::VulkanDevice* const device = GetVulkanDevice();
+  new (&completion_timeline_) ui::vulkan::VulkanGPUCompletionTimeline(device);
+  new (&transient_descriptor_allocator_uniform_buffer_)
+      ui::vulkan::LinkedTypeDescriptorSetAllocator(
+          device, &kDescriptorPoolSizeUniformBuffer, 1,
+          kLinkedTypeDescriptorPoolSetCount);
+  new (&transient_descriptor_allocator_storage_buffer_)
+      ui::vulkan::LinkedTypeDescriptorSetAllocator(
+          device, &kDescriptorPoolSizeStorageBuffer, 1,
+          kLinkedTypeDescriptorPoolSetCount);
+  new (&transient_descriptor_allocator_textures_)
+      ui::vulkan::LinkedTypeDescriptorSetAllocator(
+          device, kDescriptorPoolSizeTextures,
+          uint32_t(xe::countof(kDescriptorPoolSizeTextures)),
+          kLinkedTypeDescriptorPoolSetCount);
+}
+
+void VulkanCommandProcessor::ChimeraKeepDeviceState() {
+  chimera_kept_ = false;
+  chimera_kept_ranges_.clear();
+  chimera_kept_bytes_.clear();
+  chimera_kept_edram_.clear();
+  if (!BeginSubmission(false)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+
+  shared_memory_->ChimeraGpuWrittenRanges(chimera_kept_ranges_);
+  VkDeviceSize ranges_bytes = 0;
+  for (const auto& range : chimera_kept_ranges_) {
+    ranges_bytes += range.second;
+  }
+  VkBuffer buffer;
+  VkDeviceMemory memory;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, ranges_bytes + xenos::kEdramSizeBytes,
+          VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, buffer, memory)) {
+    XELOGE("No buffer to fetch what the device holds into");
+    chimera_kept_ranges_.clear();
+    return;
+  }
+  if (!chimera_kept_ranges_.empty()) {
+    shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+    SubmitBarriers(true);
+    VkBufferCopy* regions = deferred_command_buffer_.CmdCopyBufferEmplace(
+        shared_memory_->buffer(), buffer,
+        uint32_t(chimera_kept_ranges_.size()));
+    VkDeviceSize offset = 0;
+    for (size_t i = 0; i < chimera_kept_ranges_.size(); ++i) {
+      regions[i].srcOffset = chimera_kept_ranges_[i].first;
+      regions[i].dstOffset = offset;
+      regions[i].size = chimera_kept_ranges_[i].second;
+      offset += chimera_kept_ranges_[i].second;
+    }
+  }
+  const bool edram =
+      render_target_cache_->ChimeraCopyEdramOut(buffer, ranges_bytes);
+  PushBufferMemoryBarrier(buffer, 0, VK_WHOLE_SIZE,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_HOST_BIT,
+                          VK_ACCESS_TRANSFER_WRITE_BIT,
+                          VK_ACCESS_HOST_READ_BIT);
+  SubmitBarriers(true);
+  EndSubmission(false);
+  AwaitAllQueueOperationsCompletion();
+
+  void* mapping;
+  if (dfn.vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, &mapping) ==
+      VK_SUCCESS) {
+    // what the device wrote is asked for, not assumed to be there
+    VkMappedMemoryRange read = {VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+    read.memory = memory;
+    read.size = VK_WHOLE_SIZE;
+    dfn.vkInvalidateMappedMemoryRanges(device, 1, &read);
+    const uint8_t* bytes = static_cast<const uint8_t*>(mapping);
+    chimera_kept_bytes_.assign(bytes, bytes + ranges_bytes);
+    if (edram) {
+      chimera_kept_edram_.assign(
+          bytes + ranges_bytes, bytes + ranges_bytes + xenos::kEdramSizeBytes);
+    }
+    dfn.vkUnmapMemory(device, memory);
+    chimera_kept_ = true;
+  } else {
+    chimera_kept_ranges_.clear();
+  }
+  dfn.vkDestroyBuffer(device, buffer, nullptr);
+  dfn.vkFreeMemory(device, memory, nullptr);
+  if (chimera_kept_) {
+    ChimeraKeepReadbacks();
+  }
+}
+
+void VulkanCommandProcessor::ChimeraKeepReadbacks() {
+  chimera_kept_readbacks_.clear();
+  // a frame the last remaking left to be opened again is still the open one
+  chimera_kept_frame_open_ = frame_open_ || chimera_skip_readback_flip_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  // every submission has completed (ChimeraKeepDeviceState waited for them)
+  for (const auto& [key, rb] : readback_buffers_) {
+    ChimeraKeptReadback kept;
+    kept.key = key;
+    kept.current_index = rb.current_index;
+    kept.last_used_frame = rb.last_used_frame;
+    for (int i = 0; i < 2; ++i) {
+      if (rb.buffers[i] == VK_NULL_HANDLE || !rb.sizes[i]) {
+        continue;
+      }
+      void* mapping;
+      if (dfn.vkMapMemory(device, rb.memories[i], 0, rb.sizes[i], 0,
+                          &mapping) != VK_SUCCESS) {
+        continue;
+      }
+      VkMappedMemoryRange read = {VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+      read.memory = rb.memories[i];
+      read.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &read);
+      const uint8_t* bytes = static_cast<const uint8_t*>(mapping);
+      kept.bytes[i].assign(bytes, bytes + rb.sizes[i]);
+      kept.sizes[i] = rb.sizes[i];
+      dfn.vkUnmapMemory(device, rb.memories[i]);
+    }
+    chimera_kept_readbacks_.push_back(std::move(kept));
+  }
+}
+
+void VulkanCommandProcessor::ChimeraPutBackReadbacks() {
+  // the frame that was open is opened again, and must not flip the buffers
+  // a second time
+  chimera_skip_readback_flip_ = chimera_kept_frame_open_ && !frame_open_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (const ChimeraKeptReadback& kept : chimera_kept_readbacks_) {
+    ReadbackBuffer& rb = readback_buffers_[kept.key];
+    rb.current_index = kept.current_index;
+    rb.last_used_frame = kept.last_used_frame;
+    for (int i = 0; i < 2; ++i) {
+      if (!kept.sizes[i]) {
+        continue;
+      }
+      VkBuffer buffer;
+      VkDeviceMemory memory;
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, kept.sizes[i], VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+              ui::vulkan::util::MemoryPurpose::kReadback, buffer, memory)) {
+        continue;
+      }
+      void* mapping;
+      if (dfn.vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, &mapping) ==
+          VK_SUCCESS) {
+        std::memcpy(mapping, kept.bytes[i].data(), kept.sizes[i]);
+        VkMappedMemoryRange written = {VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+        written.memory = memory;
+        written.size = VK_WHOLE_SIZE;
+        dfn.vkFlushMappedMemoryRanges(device, 1, &written);
+        dfn.vkUnmapMemory(device, memory);
+      }
+      rb.buffers[i] = buffer;
+      rb.memories[i] = memory;
+      rb.sizes[i] = kept.sizes[i];
+      rb.submissions[i] = 0;
+    }
+  }
+}
+
+void VulkanCommandProcessor::ChimeraPutBackDeviceState() {
+  if (!chimera_kept_ || !BeginSubmission(false)) {
+    return;
+  }
+  size_t offset = 0;
+  for (const auto& range : chimera_kept_ranges_) {
+    shared_memory_->ChimeraPutBack(range.first, range.second,
+                                   chimera_kept_bytes_.data() + offset);
+    offset += range.second;
+  }
+  if (!chimera_kept_edram_.empty()) {
+    render_target_cache_->ChimeraPutEdramBack(chimera_kept_edram_.data());
+  }
+  ChimeraPutBackReadbacks();
+  // The submission stays open: the next draw carries on in it.
+}
+
+void VulkanCommandProcessor::ChimeraSubmitAll() {
+  if (submission_open_) {
+    EndSubmission(false);
+  }
+  AwaitAllQueueOperationsCompletion();
+}
