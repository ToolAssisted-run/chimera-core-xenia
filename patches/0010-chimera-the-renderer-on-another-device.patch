+bool VulkanRenderTargetCache::ChimeraCopyEdramOut(VkBuffer destination,
+                                                  VkDeviceSize offset) {
+  if (IsDrawResolutionScaled()) {
+    return false;
+  }
+  if (GetPath() == Path::kHostRenderTargets) {
+    // every tile, from whichever host render target owns it, into the buffer
+    DumpRenderTargets(0, xenos::kEdramTileCount, 1, xenos::kEdramTileCount,
+                      false);
+  }
+  UseEdramBuffer(EdramBufferUsage::kTransferRead);
+  command_processor_.SubmitBarriers(true);
+  VkBufferCopy* region =
+      command_processor_.deferred_command_buffer().CmdCopyBufferEmplace(
+          edram_buffer_, destination, 1);
+  region->srcOffset = 0;
+  region->dstOffset = offset;
+  region->size = xenos::kEdramSizeBytes;
+  return true;
+}
+
+bool VulkanRenderTargetCache::ChimeraPutEdramBack(const uint8_t* edram) {
+  if (IsDrawResolutionScaled()) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device =
+      command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (chimera_edram_staging_buffer_ == VK_NULL_HANDLE) {
+    if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+            vulkan_device, xenos::kEdramSizeBytes,
+            VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+            ui::vulkan::util::MemoryPurpose::kUpload,
+            chimera_edram_staging_buffer_, chimera_edram_staging_memory_)) {
+      XELOGE("VulkanRenderTargetCache: no buffer to put the EDRAM back from");
+      return false;
+    }
+  }
+  void* mapping;
+  if (dfn.vkMapMemory(device, chimera_edram_staging_memory_, 0, VK_WHOLE_SIZE,
+                      0, &mapping) != VK_SUCCESS) {
+    return false;
+  }
+  DeferredCommandBuffer& command_buffer =
+      command_processor_.deferred_command_buffer();
+  bool done = false;
+  switch (GetPath()) {
+    case Path::kHostRenderTargets: {
+      // One render target the size of the whole EDRAM, 16 tiles a row, owns
+      // every tile from now on; whoever draws next takes what it needs from
+      // it as from any other owner. The snapshot is a tile after another;
+      // the image is rows.
+      auto* render_target = static_cast<VulkanRenderTarget*>(
+          PrepareFullEdram1280xRenderTargetForSnapshotRestoration(
+              xenos::ColorRenderTargetFormat::k_32_FLOAT));
+      if (!render_target) {
+        break;
+      }
+      constexpr uint32_t kPitchTiles = 16;
+      constexpr uint32_t kTileRows = xenos::kEdramTileCount / kPitchTiles;
+      constexpr size_t kTileRowBytes =
+          sizeof(uint32_t) * xenos::kEdramTileWidthSamples;
+      constexpr size_t kImageRowBytes = kTileRowBytes * kPitchTiles;
+      const uint8_t* source = edram;
+      for (uint32_t y_tile = 0; y_tile < kTileRows; ++y_tile) {
+        for (uint32_t x_tile = 0; x_tile < kPitchTiles; ++x_tile) {
+          for (uint32_t row = 0; row < xenos::kEdramTileHeightSamples; ++row) {
+            std::memcpy(
+                static_cast<uint8_t*>(mapping) +
+                    (size_t(y_tile) * xenos::kEdramTileHeightSamples + row) *
+                        kImageRowBytes +
+                    x_tile * kTileRowBytes,
+                source, kTileRowBytes);
+            source += kTileRowBytes;
+          }
+        }
+      }
+      TransitionRenderTarget(*render_target, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                             VK_ACCESS_TRANSFER_WRITE_BIT,
+                             VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+      command_processor_.SubmitBarriers(true);
+      VkBufferImageCopy region = {};
+      region.bufferRowLength = kPitchTiles * xenos::kEdramTileWidthSamples;
+      region.bufferImageHeight = kTileRows * xenos::kEdramTileHeightSamples;
+      region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+      region.imageSubresource.layerCount = 1;
+      region.imageExtent.width = region.bufferRowLength;
+      region.imageExtent.height = region.bufferImageHeight;
+      region.imageExtent.depth = 1;
+      command_buffer.CmdVkCopyBufferToImage(
+          chimera_edram_staging_buffer_, render_target->image(),
+          VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+      done = true;
+    } break;
+    case Path::kPixelShaderInterlock: {
+      std::memcpy(mapping, edram, xenos::kEdramSizeBytes);
+      UseEdramBuffer(EdramBufferUsage::kTransferWrite);
+      command_processor_.SubmitBarriers(true);
+      VkBufferCopy* region = command_buffer.CmdCopyBufferEmplace(
+          chimera_edram_staging_buffer_, edram_buffer_, 1);
+      region->srcOffset = 0;
+      region->dstOffset = 0;
+      region->size = xenos::kEdramSizeBytes;
+      done = true;
+    } break;
+    default:
+      break;
+  }
+  // No memory type is known to be coherent to this renderer when the device
+  // is a sandbox's: what was written is said to have been.
+  VkMappedMemoryRange written = {VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+  written.memory = chimera_edram_staging_memory_;
+  written.size = VK_WHOLE_SIZE;
+  dfn.vkFlushMappedMemoryRanges(device, 1, &written);
+  dfn.vkUnmapMemory(device, chimera_edram_staging_memory_);
+  return done;
+}
