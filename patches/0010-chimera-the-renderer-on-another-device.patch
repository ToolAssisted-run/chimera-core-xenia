+void SharedMemory::ChimeraGpuWrittenRanges(
+    std::vector<std::pair<uint32_t, uint32_t>>& ranges_out) {
+  ranges_out.clear();
+  auto global_lock = global_critical_region_.Acquire();
+  const uint32_t page_count = num_system_page_flags_ << 6;
+  uint32_t range_start = UINT32_MAX;
+  for (uint32_t page = 0; page <= page_count; ++page) {
+    const bool written =
+        page < page_count &&
+        (system_page_flags_valid_and_gpu_written_[page >> 6] &
+         (uint64_t(1) << (page & 63))) != 0;
+    if (written) {
+      if (range_start == UINT32_MAX) {
+        range_start = page;
+      }
+    } else if (range_start != UINT32_MAX) {
+      ranges_out.emplace_back(range_start << page_size_log2_,
+                              (page - range_start) << page_size_log2_);
+      range_start = UINT32_MAX;
+    }
+  }
+}
