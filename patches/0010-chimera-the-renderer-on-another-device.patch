+// this renderer made belongs to a device that is gone - or the gate asks,
+// to see that it changes nothing. The context is taken down, the provider
+// and the presenter are made again, and the context is set up on what they
+// are now. The shaders in use belonged to the context and are loaded again
+// from their own code.
+//
+// keep_device_state: the device being left still answers, so what only it
+// holds is fetched first. After a load it does not, and what was fetched
+// before the state was saved is what is put back.
+void CommandProcessor::ChimeraRemakeContext(bool keep_device_state) {
+  if (!chimera_context_up_) {
+    // Nothing to take down: the worker has not been here yet, and will set
+    // its context up on whatever device there is when it first runs.
+    ChimeraLeaveDevice();
+    graphics_system_->ChimeraRemakeDevice();
+    ChimeraEnterDevice();
+    return;
+  }
+  if (keep_device_state) {
+    ChimeraSubmitAll();
+    ChimeraKeepDeviceState();
+  }
+  std::vector<uint32_t> vertex_ucode, pixel_ucode;
+  if (active_vertex_shader_) {
+    vertex_ucode = active_vertex_shader_->ucode_data();
+  }
+  if (active_pixel_shader_) {
+    pixel_ucode = active_pixel_shader_->ucode_data();
+  }
+  // What the occlusion queries had counted outlives the context (it is
+  // gathered: a submission's end closes the open segment, and the fetch
+  // above, or the one made when the state being loaded was saved, waited for
+  // every resolve and took it in). Without this a query still counting lost
+  // its count, and a run with a load had other answers (Mirror's Edge with
+  // strict queries, frame 898).
+  ChimeraZPDState zpd = ChimeraTakeZPDState();
+  ShutdownContext();
+  active_vertex_shader_ = nullptr;
+  active_pixel_shader_ = nullptr;
+  ChimeraLeaveDevice();
+  graphics_system_->ChimeraRemakeDevice();
+  ChimeraEnterDevice();
+  if (!SetupContext()) {
+    xe::FatalError("Unable to set the command processor up on a new device");
+    return;
+  }
+  ChimeraPutZPDStateBack(std::move(zpd));
+  if (!vertex_ucode.empty()) {
+    active_vertex_shader_ =
+        LoadShader(xenos::ShaderType::kVertex, 0, vertex_ucode.data(),
+                   uint32_t(vertex_ucode.size()));
+  }
+  if (!pixel_ucode.empty()) {
+    active_pixel_shader_ =
+        LoadShader(xenos::ShaderType::kPixel, 0, pixel_ucode.data(),
+                   uint32_t(pixel_ucode.size()));
+  }
+  ChimeraPutBackDeviceState();
+}
+
+CommandProcessor::ChimeraZPDState CommandProcessor::ChimeraTakeZPDState() {
+  ChimeraZPDState kept;
+  kept.next_report_handle = zpd_next_report_handle_;
+  kept.current_report = zpd_current_report_;
+  // a segment still open on the device is lost with it; its report resumes
+  // at the next draw, as it does after a render pass ends
+  kept.segment_pending_begin =
+      active_segment_.segment_pending_begin ||
+      (active_segment_.segment_active && active_segment_.report);
+  kept.reports = std::move(zpd_reports_);
+  kept.awaited_report_count = zpd_awaited_report_count_;
+  kept.fast_cached_deltas = std::move(fast_zpd_report_cached_deltas_);
+  kept.sample_counter = zpd_sample_counter_;
+  kept.speculative_sample_counter = zpd_speculative_sample_counter_;
+  kept.fake_sample_count = fake_zpd_sample_count_;
+  kept.pending_retire_start_ms = zpd_pending_retire_start_ms_;
+  kept.force_fake_fallback = zpd_force_fake_fallback_;
+  return kept;
+}
+
+void CommandProcessor::ChimeraPutZPDStateBack(ChimeraZPDState&& kept) {
+  zpd_next_report_handle_ = kept.next_report_handle;
+  zpd_current_report_ = kept.current_report;
+  active_segment_.segment_pending_begin = kept.segment_pending_begin;
+  zpd_reports_ = std::move(kept.reports);
+  zpd_awaited_report_count_ = kept.awaited_report_count;
+  fast_zpd_report_cached_deltas_ = std::move(kept.fast_cached_deltas);
+  zpd_sample_counter_ = kept.sample_counter;
+  zpd_speculative_sample_counter_ = kept.speculative_sample_counter;
+  fake_zpd_sample_count_ = kept.fake_sample_count;
+  zpd_pending_retire_start_ms_ = kept.pending_retire_start_ms;
+  zpd_force_fake_fallback_ = kept.force_fake_fallback;
+  // A resolve the old device never delivered never will be: the segments
+  // it measured are counted as nothing, so the report can retire.
+  zpd_current_report_.pending_segments = 0;
+  for (ZPDReport& report : zpd_reports_) {
+    report.pending_segments = 0;
+  }
+}
