+bool VulkanSharedMemory::ChimeraPutBack(uint32_t start, uint32_t length,
+                                        const uint8_t* data) {
+  if (!length) {
+    return true;
+  }
+  if (!ChimeraEnsureAllocated(start, length)) {
+    return false;
+  }
+  Use(Usage::kTransferDestination, std::make_pair(start, length));
+  command_processor_.SubmitBarriers(true);
+  DeferredCommandBuffer& command_buffer =
+      command_processor_.deferred_command_buffer();
+  const uint64_t submission_current = command_processor_.GetCurrentSubmission();
+  uint32_t done = 0;
+  while (done < length) {
+    VkBuffer upload_buffer;
+    VkDeviceSize upload_buffer_offset, upload_buffer_size;
+    uint8_t* upload_buffer_mapping = upload_buffer_pool_->RequestPartial(
+        submission_current, length - done, size_t(1) << page_size_log2(),
+        upload_buffer, upload_buffer_offset, upload_buffer_size);
+    if (upload_buffer_mapping == nullptr) {
+      XELOGE("Shared memory: Failed to get a Vulkan upload buffer");
+      return false;
+    }
+    std::memcpy(upload_buffer_mapping, data + done, upload_buffer_size);
+    VkBufferCopy* region =
+        command_buffer.CmdCopyBufferEmplace(upload_buffer, buffer_, 1);
+    region->srcOffset = upload_buffer_offset;
+    region->dstOffset = VkDeviceSize(start) + done;
+    region->size = upload_buffer_size;
+    done += uint32_t(upload_buffer_size);
+  }
+  // valid, and the device's: a write by the program to these pages is still
+  // heard of, and they are not uploaded from a memory that never had them
+  MakeRangeValid(start, length, true);
+  return true;
+}
