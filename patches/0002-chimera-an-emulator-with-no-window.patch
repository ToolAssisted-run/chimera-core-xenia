+// chimera: "the system's UI has closed", a little later. Upstream starts a
+// host thread to say it. With one thread running at a time on the machine's
+// own clock the thread has to be one of the machine's - a host thread
+// sleeping on the host would say it at a moment no two runs agree on, and in
+// a sandbox would not be one of the schedule's at all.
+static void ChimeraSayUiClosedLater() {
+#ifdef CHIMERA_VSCHED
+  xe::threading::Thread::CreationParameters parameters;
+  auto thread = xe::threading::Thread::Create(parameters, []() {
+    xe::threading::Sleep(kUIDelayMillis);
+    kernel_state()->BroadcastNotification(kXNotificationSystemUI, false);
+  });
+  // it ends by itself; nobody waits for it
+  (void)thread.release();
+#else
+  std::jthread t([]() {
+    xe::threading::Sleep(kUIDelayMillis);
+    kernel_state()->BroadcastNotification(kXNotificationSystemUI, false);
+  });
+  t.detach();
+#endif
+}
