+bool DiscImageDevice::ReadImage(size_t offset, void* buffer, size_t length) {
+  auto global_lock = global_critical_region_.Acquire();
+  if (!image_ || offset > image_size_ || length > image_size_ - offset) {
+    return false;
+  }
+  if (!xe::filesystem::Seek(image_, static_cast<int64_t>(offset), SEEK_SET)) {
+    return false;
