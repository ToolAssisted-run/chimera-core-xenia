+#ifdef CHIMERA_NOFILEMAP
+// chimera: a sandbox maps no file into memory. What is asked for is read
+// into memory instead, whole. Nothing written to it goes back to the file:
+// the files a machine is given are not written, and what it keeps of its
+// own is in its storage, which is memory already.
+class ReadMappedMemory : public MappedMemory {
+ public:
+  ReadMappedMemory(void* data, size_t size) : MappedMemory(data, size) {}
+  ~ReadMappedMemory() override { std::free(data_); }
+  void Close(uint64_t truncate_size) override {
+    std::free(data_);
+    data_ = nullptr;
+  }
+};
+
+std::unique_ptr<MappedMemory> MappedMemory::Open(
+    const std::filesystem::path& path, Mode mode, size_t offset,
+    size_t length) {
+  FILE* file = std::fopen(path.c_str(), "rb");
+  if (!file) {
+    return nullptr;
+  }
+  if (fseeko(file, 0, SEEK_END) != 0) {
+    std::fclose(file);
+    return nullptr;
+  }
+  const size_t file_size = size_t(ftello(file));
+  const size_t map_length =
+      length ? length : (file_size > offset ? file_size - offset : 0);
+  // what lies past the end of the file reads as zero, as a mapping's last
+  // page does
+  void* data = map_length ? std::calloc(1, map_length) : nullptr;
+  if (!data) {
+    std::fclose(file);
+    return nullptr;
+  }
+  if (offset < file_size) {
+    const size_t wanted = std::min(map_length, file_size - offset);
+    if (fseeko(file, off_t(offset), SEEK_SET) != 0 ||
+        std::fread(data, 1, wanted, file) != wanted) {
+      std::free(data);
+      std::fclose(file);
+      return nullptr;
+    }
+  }
+  std::fclose(file);
+  return std::make_unique<ReadMappedMemory>(data, map_length);
+}
