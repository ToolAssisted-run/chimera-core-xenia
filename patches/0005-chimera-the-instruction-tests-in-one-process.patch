 bool DiscoverTests(const std::filesystem::path& test_path,
                    std::vector<std::filesystem::path>& test_files) {
+#ifdef CHIMERA_GUEST
+  // chimera: a guest has files and no directories. The tests are the names
+  // in tests.list, one a line, which the host mounted beside them.
+  if (FILE* list = std::fopen("tests.list", "r")) {
+    char name[256];
+    while (std::fgets(name, sizeof(name), list)) {
+      std::string line(name);
+      while (!line.empty() && (line.back() == '\n' || line.back() == '\r')) {
+        line.pop_back();
+      }
+      if (!line.empty()) {
+        test_files.push_back(test_path / line);
+      }
+    }
+    std::fclose(list);
+    return true;
+  }
+  return false;
+#endif
