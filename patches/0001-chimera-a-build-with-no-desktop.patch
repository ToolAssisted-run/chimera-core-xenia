diff --git a/CMakeLists.txt b/CMakeLists.txt
index 30febc4b7..7b7b7ad3c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,6 +36,12 @@ message(STATUS "Target architecture: XE_TARGET_AARCH64=${XE_TARGET_AARCH64} XE_T
 # Options
 option(XENIA_BUILD_TESTS "Build test suites" OFF)
 option(XENIA_BUILD_MISC "Build misc subprojects (trace viewers, shader compiler, vfs-dump, demos)" OFF)
+# chimera: the emulator as libraries and nothing that needs a desktop - no
+# window, no toolkit, no host audio or pad driver, no application.
+option(CHIMERA_HEADLESS "Build without the window system and the application" OFF)
+if(CHIMERA_HEADLESS)
+  add_compile_definitions(CHIMERA_HEADLESS=1)
+endif()
 
 # Toggle profiler
 add_compile_definitions(XE_OPTION_PROFILING=0)
@@ -248,6 +254,9 @@ else()
       pthread
     )
   elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    if(CHIMERA_HEADLESS)
+      link_libraries(stdc++fs dl pthread rt)
+    else()
     # GTK3 via pkg-config
     find_package(PkgConfig REQUIRED)
     pkg_check_modules(GTK3 REQUIRED gtk+-x11-3.0)
@@ -257,6 +266,7 @@ else()
 
     # Global Linux libraries
     link_libraries(stdc++fs dl lz4 pthread rt)
+    endif()
 
     # Link groups for executables (resolves circular deps)
     set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,--start-group")
