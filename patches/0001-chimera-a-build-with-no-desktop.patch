new file mode 100644
index 000000000..9b81a0f1b
--- /dev/null
+++ b/src/xenia/ui/chimera_headless.cc
@@ -0,0 +1,21 @@
+// chimera: what the window system's files define, for a build that has none.
+// Nothing here can show anything: each answers as a desktop would when the
+// user declines.
+#include "xenia/ui/file_picker.h"
+
+namespace xe {
+namespace ui {
+
+namespace {
+class NoFilePicker : public FilePicker {
+ public:
+  bool Show(Window* parent_window) override { return false; }
+};
+}  // namespace
+
+std::unique_ptr<FilePicker> FilePicker::Create() {
+  return std::make_unique<NoFilePicker>();
+}
+
+}  // namespace ui
+}  // namespace xe
