 namespace utfcpp = utf8;
 
+#if !XE_PLATFORM_WIN32
+namespace {
+
+// Windows-1252 bytes 0x80-0x9F as Unicode. The five bytes Windows leaves
+// undefined (0x81, 0x8D, 0x8F, 0x90, 0x9D) map to the same-numbered control
+// code point, as Windows does.
+constexpr uint16_t kWin1252High[32] = {
+    0x20AC, 0x0081, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021,
+    0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x008D, 0x017D, 0x008F,
+    0x0090, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
+    0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x009D, 0x017E, 0x0178};
+
+// The Windows-1252 byte for a code point, or -1 if it has none.
+int CodePointToWin1252(uint32_t cp) {
+  if (cp < 0x80 || (cp >= 0xA0 && cp <= 0xFF)) {
+    return static_cast<int>(cp);
+  }
+  for (uint32_t i = 0; i < 32; ++i) {
+    if (kWin1252High[i] == cp) {
+      return static_cast<int>(0x80 + i);
+    }
+  }
+  return -1;
+}
+
+void AppendUtf8(std::string& out, uint32_t cp) {
+  if (cp < 0x80) {
+    out.push_back(static_cast<char>(cp));
+  } else if (cp < 0x800) {
+    out.push_back(static_cast<char>(0xC0 | (cp >> 6)));
+    out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+  } else {
+    out.push_back(static_cast<char>(0xE0 | (cp >> 12)));
+    out.push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
+    out.push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+  }
+}
+
+}  // namespace
+#endif  // !XE_PLATFORM_WIN32
+
