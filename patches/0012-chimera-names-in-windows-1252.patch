+  output_str.reserve(source.size());
+  size_t i = 0;
+  while (i < source.size()) {
+    uint8_t lead = static_cast<uint8_t>(source[i]);
+    size_t extra = lead < 0x80             ? 0
+                   : (lead & 0xE0) == 0xC0 ? 1
+                   : (lead & 0xF0) == 0xE0 ? 2
+                   : (lead & 0xF8) == 0xF0 ? 3
+                                           : size_t(-1);
+    if (extra == size_t(-1)) {
+      output_str.push_back('_');
