+void EnableAffinityConfiguration() {}
+
+uint32_t current_thread_system_id() { return Self()->id; }
+void set_name(const std::string_view name) {
+  VThread* self = Self();
+  self->name = std::string(name);
+  if (self->handle) {
+    self->handle->Thread::set_name(std::string(name));
+  }
+}
+
+void MaybeYield() { YieldNow(Self()); }
+void SyncMemory() {}
+
+void NanoSleep(int64_t ns) {
+  VThread* self = Self();
+  if (ns <= 0) {
+    YieldNow(self);
+    return;
+  }
+  Account();
+  Block(self, nullptr, 0, false, false, S().now + ns, nullptr);
+}
+void NanoSleepPrecise(int64_t ns) { NanoSleep(ns); }
+void Sleep(std::chrono::microseconds duration) {
+  NanoSleep(duration.count() * 1000);
+}
+SleepResult AlertableSleep(std::chrono::microseconds duration) {
+  VThread* self = Self();
+  const int64_t ns = std::max<int64_t>(duration.count(), 0) * 1000;
+  Account();
+  const WaitResult r =
+      Block(self, nullptr, 0, false, true, S().now + ns, nullptr);
+  return r == WaitResult::kUserCallback ? SleepResult::kAlerted
+                                        : SleepResult::kSuccess;
+}
+
+TlsHandle AllocateTlsHandle() {
+  auto& s = S();
+  for (uint32_t i = 0; i < 64; i++) {
+    if (!(s.tls_used & (uint64_t(1) << i))) {
+      s.tls_used |= uint64_t(1) << i;
+      for (VThread* t : s.threads) {
+        t->tls[i] = 0;
+      }
+      return i;
+    }
+  }
+  return kInvalidTlsHandle;
+}
+bool FreeTlsHandle(TlsHandle handle) {
+  if (handle >= 64) {
+    return false;
+  }
+  S().tls_used &= ~(uint64_t(1) << handle);
+  return true;
+}
+uintptr_t GetTlsValue(TlsHandle handle) {
+  return handle < 64 ? Self()->tls[handle] : 0;
+}
+bool SetTlsValue(TlsHandle handle, uintptr_t value) {
+  if (handle >= 64) {
+    return false;
+  }
+  Self()->tls[handle] = value;
+  return true;
+}
+
+WaitResult Wait(WaitHandle* wait_handle, bool is_alertable,
+                std::chrono::milliseconds timeout) {
+  VWaitable* w = static_cast<VWaitable*>(wait_handle->native_handle());
+  return Block(Self(), &w, 1, false, is_alertable, DeadlineAfter(timeout),
+               nullptr);
+}
+
+WaitResult SignalAndWait(WaitHandle* wait_handle_to_signal,
+                         WaitHandle* wait_handle_to_wait_on, bool is_alertable,
+                         std::chrono::milliseconds timeout) {
+  // Nothing can come between the two here: the baton is not given up until
+  // the wait.
+  VWaitable* signal =
+      static_cast<VWaitable*>(wait_handle_to_signal->native_handle());
+  if (auto* event = dynamic_cast<ChimeraEvent*>(signal)) {
+    event->Set();
+  } else if (auto* semaphore = dynamic_cast<ChimeraSemaphore*>(signal)) {
+    semaphore->Release(1, nullptr);
+  } else if (auto* mutant = dynamic_cast<ChimeraMutant*>(signal)) {
+    mutant->Release();
+  } else {
+    return WaitResult::kFailed;
+  }
+  return Wait(wait_handle_to_wait_on, is_alertable, timeout);
+}
+
+std::pair<WaitResult, size_t> WaitMultiple(WaitHandle* wait_handles[],
+                                           size_t wait_handle_count,
+                                           bool wait_all, bool is_alertable,
+                                           std::chrono::milliseconds timeout) {
+  std::vector<VWaitable*> waits(wait_handle_count);
+  for (size_t i = 0; i < wait_handle_count; i++) {
+    waits[i] = static_cast<VWaitable*>(wait_handles[i]->native_handle());
+  }
+  size_t index = 0;
+  const WaitResult r = Block(Self(), waits.data(), waits.size(), wait_all,
+                             is_alertable, DeadlineAfter(timeout), &index);
+  return {r, index};
+}
+
+std::unique_ptr<Event> Event::CreateManualResetEvent(bool initial_state) {
+  return std::make_unique<ChimeraEvent>(true, initial_state);
+}
+std::unique_ptr<Event> Event::CreateAutoResetEvent(bool initial_state) {
+  return std::make_unique<ChimeraEvent>(false, initial_state);
+}
+std::unique_ptr<Semaphore> Semaphore::Create(int initial_count,
+                                             int maximum_count) {
+  if (initial_count < 0 || initial_count > maximum_count ||
+      maximum_count <= 0) {
+    return nullptr;
+  }
+  return std::make_unique<ChimeraSemaphore>(initial_count, maximum_count);
+}
+std::unique_ptr<Mutant> Mutant::Create(bool initial_owner) {
+  return std::make_unique<ChimeraMutant>(initial_owner);
+}
+std::unique_ptr<Timer> Timer::CreateManualResetTimer() {
+  return std::make_unique<ChimeraTimer>(true);
+}
+std::unique_ptr<Timer> Timer::CreateSynchronizationTimer() {
+  return std::make_unique<ChimeraTimer>(false);
+}
+
+std::unique_ptr<Thread> Thread::Create(CreationParameters params,
+                                       std::function<void()> start_routine) {
+  auto& s = S();
+  Self();  // whoever creates a thread is in the schedule first
+  VThread* t = new VThread();
+  t->id = s.next_id++;
+  t->logical_id = t->id;
+  t->start = std::move(start_routine);
+  t->suspend_count = params.create_suspended ? 1 : 0;
+  t->priority = params.initial_priority;
+
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setstacksize(&attr,
+                            std::max<size_t>(params.stack_size, 1u << 20));
+  pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+  const int error = pthread_create(&t->host, &attr, HostMain, t);
+  pthread_attr_destroy(&attr);
+  if (error) {
+    delete t;
+    return nullptr;
+  }
+  s.threads.push_back(t);
+  return std::make_unique<ChimeraThread>(t);
+}
+
+Thread* Thread::GetCurrentThread() { return Self()->handle; }
+
+void Thread::Exit(int exit_code) {
+  EndCurrent(Self());
+  pthread_exit(reinterpret_cast<void*>(static_cast<intptr_t>(exit_code)));
+}
