+// ---------------------------------------------------------------------------
+// The timer queue (threading_timer_queue.h), on this file's time. One thread
+// sleeps until the earliest item is due and runs it.
+
+class TimerQueue {
+ public:
+  static TimerQueue& Get() {
+    static TimerQueue* queue = new TimerQueue();
+    return *queue;
+  }
+
+  std::weak_ptr<TimerQueueWaitItem> Queue(
+      std::function<void(void*)> callback, void* userdata,
+      TimerQueueWaitItem::clock::time_point due,
+      TimerQueueWaitItem::clock::duration interval) {
+    auto item = std::make_shared<TimerQueueWaitItem>(std::move(callback),
+                                                     userdata, this, due,
+                                                     interval);
+    items_.push_back(item);
+    Start();
+    changed_->Set();
+    return item;
+  }
+
+  void Disarm(TimerQueueWaitItem* item) {
+    using State = TimerQueueWaitItem::State;
+    if (item->state_.load() == State::kInCallback) {
+      if (running_on_ == Self()) {
+        // from inside its own callback: it is not queued again
+        item->state_.store(State::kInCallbackSelfDisarmed);
+        return;
+      }
+      // somebody else's callback is part way through: wait for it
+      while (item->state_.load() == State::kInCallback) {
+        YieldNow(Self());
+      }
+    }
+    item->state_.store(State::kDisarmed);
+    for (auto it = items_.begin(); it != items_.end(); ++it) {
+      if (it->get() == item) {
+        items_.erase(it);
+        break;
+      }
+    }
+    changed_->Set();
+  }
+
+ private:
+  TimerQueue() { changed_ = Event::CreateAutoResetEvent(false); }
+
+  void Start() {
+    if (thread_) {
+      return;
+    }
+    Thread::CreationParameters params;
+    thread_ = Thread::Create(params, [this] { Main(); });
+    thread_->set_name("chimera timer queue");
+  }
+
+  void Main() {
+    using State = TimerQueueWaitItem::State;
+    running_on_ = Self();
+    for (;;) {
+      std::shared_ptr<TimerQueueWaitItem> next;
+      for (auto& item : items_) {
+        if (!next || item->due_ < next->due_) {
+          next = item;
+        }
+      }
+      const auto now = chimera::SteadyNow();
+      if (!next || next->due_ > now) {
+        // until the earliest is due, or the queue changes
+        VWaitable* w = static_cast<VWaitable*>(changed_->native_handle());
+        const int64_t deadline =
+            next ? std::chrono::duration_cast<std::chrono::nanoseconds>(
+                       next->due_.time_since_epoch())
+                       .count()
+                 : kNever;
+        Block(Self(), &w, 1, false, false, deadline, nullptr);
+        continue;
+      }
+      next->state_.store(State::kInCallback);
+      next->callback_(next->userdata_);
+      if (next->state_.load() == State::kInCallbackSelfDisarmed ||
+          next->interval_ == TimerQueueWaitItem::clock::duration::zero()) {
+        next->state_.store(State::kDisarmed);
+        items_.erase(std::remove(items_.begin(), items_.end(), next),
+                     items_.end());
+      } else {
+        next->due_ += next->interval_;
+        next->state_.store(State::kIdle);
+      }
+    }
+  }
+
+  std::vector<std::shared_ptr<TimerQueueWaitItem>> items_;
+  std::unique_ptr<Event> changed_;
+  std::unique_ptr<Thread> thread_;
+  VThread* running_on_ = nullptr;
+};
+
+void TimerQueueWaitItem::Disarm() { parent_queue_->Disarm(this); }
+
+std::weak_ptr<TimerQueueWaitItem> QueueTimerOnce(
+    std::function<void(void*)> callback, void* userdata,
+    TimerQueueWaitItem::clock::time_point due) {
+  return TimerQueue::Get().Queue(std::move(callback), userdata, due,
+                                 TimerQueueWaitItem::clock::duration::zero());
+}
+
+std::weak_ptr<TimerQueueWaitItem> QueueTimerRecurring(
+    std::function<void(void*)> callback, void* userdata,
+    TimerQueueWaitItem::clock::time_point due,
+    TimerQueueWaitItem::clock::duration interval) {
+  return TimerQueue::Get().Queue(std::move(callback), userdata, due, interval);
+}
