diff --git a/src/xenia/base/chimera_sync.h b/src/xenia/base/chimera_sync.h
new file mode 100644
index 000000000..563a386a3
--- /dev/null
+++ b/src/xenia/base/chimera_sync.h
@@ -0,0 +1,206 @@
+// chimera: locks and condition variables that wait in the scheduler.
+//
+// With one thread running at a time (threading_chimera.cc), a lock is a flag:
+// nothing can come between testing it and setting it. What a lock must NOT do
+// is put its thread to sleep on the host when it finds the flag set - that
+// thread holds the baton, and the one that would clear the flag never runs
+// again. So a contended lock, and a condition variable, wait where every
+// other wait does, and the scheduler runs somebody else.
+//
+// Without the scheduler these are the standard library's own.
+#ifndef XENIA_BASE_CHIMERA_SYNC_H_
+#define XENIA_BASE_CHIMERA_SYNC_H_
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+#include "xenia/base/chimera_vsched.h"
+
+namespace xe {
+namespace sync {
+
+#ifdef CHIMERA_VSCHED
+
+class mutex {
+ public:
+  mutex() = default;
+  mutex(const mutex&) = delete;
+  mutex& operator=(const mutex&) = delete;
+  void lock() {
+    if (locked_) {
+      chimera::WaitFor([this] { return !locked_; }, INT64_MAX);
+    }
+    locked_ = true;
+  }
+  void unlock() { locked_ = false; }
+  bool try_lock() {
+    if (locked_) {
+      return false;
+    }
+    locked_ = true;
+    return true;
+  }
+
+ private:
+  bool locked_ = false;
+};
+
+class recursive_mutex {
+ public:
+  recursive_mutex() = default;
+  recursive_mutex(const recursive_mutex&) = delete;
+  recursive_mutex& operator=(const recursive_mutex&) = delete;
+  void lock() {
+    const void* me = chimera::CurrentThread();
+    if (owner_ == me) {
+      count_++;
+      return;
+    }
+    if (owner_) {
+      chimera::WaitFor([this] { return owner_ == nullptr; }, INT64_MAX);
+    }
+    owner_ = me;
+    count_ = 1;
+  }
+  void unlock() {
+    if (--count_ == 0) {
+      owner_ = nullptr;
+    }
+  }
+  bool try_lock() {
+    const void* me = chimera::CurrentThread();
+    if (owner_ && owner_ != me) {
+      return false;
+    }
+    owner_ = me;
+    count_++;
+    return true;
+  }
+
+ private:
+  const void* owner_ = nullptr;
+  uint32_t count_ = 0;
+};
+
+// notify_one lets one waiter go, notify_all every waiter there is; a waiter
+// that arrives afterwards waits. A wake-up with nothing to show for it is
+// allowed, as it is of the standard one.
+class condition_variable_any {
+ public:
+  condition_variable_any() = default;
+  condition_variable_any(const condition_variable_any&) = delete;
+  condition_variable_any& operator=(const condition_variable_any&) = delete;
+
+  void notify_one() {
+    if (tokens_ < waiters_) {
+      tokens_++;
+    }
+  }
+  void notify_all() {
+    generation_++;
+    tokens_ = 0;
+  }
+
+  template <typename Lock>
+  void wait(Lock& lock) {
+    WaitUntilNs(lock, INT64_MAX);
+  }
+  template <typename Lock, typename Predicate>
+  void wait(Lock& lock, Predicate predicate) {
+    while (!predicate()) {
+      WaitUntilNs(lock, INT64_MAX);
+    }
+  }
+  template <typename Lock, typename Rep, typename Period>
+  std::cv_status wait_for(Lock& lock,
+                          const std::chrono::duration<Rep, Period>& time) {
+    return WaitUntilNs(lock, DeadlineAfter(time)) ? std::cv_status::no_timeout
+                                                  : std::cv_status::timeout;
+  }
+  template <typename Lock, typename Rep, typename Period, typename Predicate>
+  bool wait_for(Lock& lock, const std::chrono::duration<Rep, Period>& time,
+                Predicate predicate) {
+    const int64_t deadline = DeadlineAfter(time);
+    while (!predicate()) {
+      if (!WaitUntilNs(lock, deadline)) {
+        return predicate();
+      }
+    }
+    return true;
+  }
+  // A moment on the steady clock is a moment of the machine's time
+  // (XE_STEADY_NOW).
+  template <typename Lock, typename Duration>
+  std::cv_status wait_until(
+      Lock& lock,
+      const std::chrono::time_point<std::chrono::steady_clock, Duration>& t) {
+    return WaitUntilNs(lock, Nanoseconds(t.time_since_epoch()))
+               ? std::cv_status::no_timeout
+               : std::cv_status::timeout;
+  }
+  template <typename Lock, typename Duration, typename Predicate>
+  bool wait_until(
+      Lock& lock,
+      const std::chrono::time_point<std::chrono::steady_clock, Duration>& t,
+      Predicate predicate) {
+    const int64_t deadline = Nanoseconds(t.time_since_epoch());
+    while (!predicate()) {
+      if (!WaitUntilNs(lock, deadline)) {
+        return predicate();
+      }
+    }
+    return true;
+  }
+
+ private:
+  template <typename D>
+  static int64_t Nanoseconds(const D& d) {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(d).count();
+  }
+  template <typename D>
+  static int64_t DeadlineAfter(const D& d) {
+    const int64_t ns = Nanoseconds(d);
+    const int64_t now = chimera::VirtualNanoseconds();
+    return ns <= 0 ? now : (ns > INT64_MAX - now ? INT64_MAX : now + ns);
+  }
+  // False when the deadline came first.
+  template <typename Lock>
+  bool WaitUntilNs(Lock& lock, int64_t deadline) {
+    const uint64_t generation = generation_;
+    waiters_++;
+    lock.unlock();
+    const bool woken = chimera::WaitFor(
+        [this, generation] { return generation_ != generation || tokens_; },
+        deadline);
+    if (woken && generation_ == generation) {
+      tokens_--;
+    }
+    waiters_--;
+    if (tokens_ > waiters_) {
+      tokens_ = waiters_;
+    }
+    lock.lock();
+    return woken;
+  }
+
+  uint64_t generation_ = 0;
+  uint32_t waiters_ = 0;
+  uint32_t tokens_ = 0;
+};
+using condition_variable = condition_variable_any;
+
+#else  // !CHIMERA_VSCHED
+
+using mutex = std::mutex;
+using recursive_mutex = std::recursive_mutex;
+using condition_variable = std::condition_variable;
+using condition_variable_any = std::condition_variable_any;
+
+#endif  // CHIMERA_VSCHED
+
+}  // namespace sync
+}  // namespace xe
+
+#endif  // XENIA_BASE_CHIMERA_SYNC_H_
diff --git a/src/xenia/base/chimera_vsched.h b/src/xenia/base/chimera_vsched.h
new file mode 100644
index 000000000..8cffead15
--- /dev/null
+++ b/src/xenia/base/chimera_vsched.h
@@ -0,0 +1,75 @@
+// chimera: the one clock, and what moves it (threading_chimera.cc).
+#ifndef XENIA_BASE_CHIMERA_VSCHED_H_
+#define XENIA_BASE_CHIMERA_VSCHED_H_
+
+#include <chrono>
+#include <cstdint>
+#include <functional>
+
+namespace xe {
+namespace chimera {
+
+// The machine's time, in nanoseconds since it was switched on.
+int64_t VirtualNanoseconds();
+
+// Time passes for whoever is running: what guest code charges for the
+// instructions it ran.
+void Charge(int64_t ns);
+
+// Let the next thread that can run, run.
+void Yield();
+
+// Sleep until a moment of the machine's time.
+void SleepUntil(int64_t ns);
+
+// Wait, in the scheduler, until `ready` says so or the machine's time reaches
+// `deadline_ns` (INT64_MAX: for ever). True when ready, false when the deadline
+// came first. `ready` is asked whenever the baton is passed and must only
+// read.
+bool WaitFor(const std::function<bool()>& ready, int64_t deadline_ns);
+
+// Which thread is running: a name for it, good for comparing.
+const void* CurrentThread();
+
+// What is left of the running thread's slice, in guest instructions. The
+// recompiler takes each block's count from it (one global: only one thread
+// runs) and calls BudgetSpent when it goes below zero. The scheduler turns
+// what was taken into time whenever it is asked anything.
+extern int64_t g_instruction_budget;
+uint64_t BudgetSpent(void* raw_context);
+
+// How many times the baton has been handed over.
+uint64_t Switches();
+
+// For finding where two runs part: every time a thread gives the baton up -
+// which one, how, when - on standard error.
+extern bool g_trace_schedule;
+
+// The frame's cadence: frame k ends k/60 s after the machine was switched on,
+// to the nanosecond below. The vertical blank is raised on it and the
+// frontend's frame ends just after it, so the two cannot drift apart.
+inline int64_t FrameBoundaryNs(int64_t k) { return k * 1000000000ll / 60; }
+// The first boundary after a moment.
+inline int64_t NextFrameBoundaryNs(int64_t now) {
+  int64_t k = now * 60 / 1000000000ll;
+  while (FrameBoundaryNs(k) <= now) {
+    k++;
+  }
+  return FrameBoundaryNs(k);
+}
+
+// The machine's time as a moment on the steady clock's scale: what everything
+// that asked the host "what time is it" asks instead.
+std::chrono::steady_clock::time_point SteadyNow();
+
+}  // namespace chimera
+}  // namespace xe
+
+// "What time is it", for code that used to ask the host's steady clock.
+#ifdef CHIMERA_VSCHED
+#define XE_STEADY_NOW() ::xe::chimera::SteadyNow()
+#else
+#define XE_STEADY_NOW() ::std::chrono::steady_clock::now()
+#endif
+
+#endif  // XENIA_BASE_CHIMERA_VSCHED_H_
