+int64_t g_instruction_budget = threading::kSliceInstructions;
+bool g_trace_schedule = false;
+
+uint64_t BudgetSpent(void*) {
+  threading::YieldNow(threading::Self());
+  return 0;
+}
+
+int64_t VirtualNanoseconds() {
+  threading::Account();
+  return threading::S().now;
+}
+
+void Charge(int64_t ns) {
+  if (ns > 0) {
+    threading::S().now += ns;
+  }
+}
+
+void Yield() { threading::YieldNow(threading::Self()); }
+
+void SleepUntil(int64_t ns) {
+  threading::Block(threading::Self(), nullptr, 0, false, false, ns, nullptr);
+}
+
+uint64_t Switches() { return threading::S().switches; }
+
+bool WaitFor(const std::function<bool()>& ready, int64_t deadline_ns) {
+  if (ready()) {
+    return true;
+  }
+  struct Predicate final : threading::VWaitable {
+    explicit Predicate(const std::function<bool()>& f) : ready(f) {}
+    bool Signaled(const threading::VThread*) const override { return ready(); }
+    void Acquire(threading::VThread*) override {}
+    const std::function<bool()>& ready;
+  } predicate(ready);
+  threading::VWaitable* w = &predicate;
+  return threading::Block(threading::Self(), &w, 1, false, false, deadline_ns,
+                          nullptr) == threading::WaitResult::kSuccess;
+}
+
+const void* CurrentThread() { return threading::Self(); }
+
+std::chrono::steady_clock::time_point SteadyNow() {
+  return std::chrono::steady_clock::time_point(
+      std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+          std::chrono::nanoseconds(VirtualNanoseconds())));
+}
