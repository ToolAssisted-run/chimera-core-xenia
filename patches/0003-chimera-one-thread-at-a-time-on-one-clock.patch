+VThread* Adopt(const char* name) {
+  auto& s = S();
+  VThread* t = new VThread();
+  t->id = s.next_id++;
+  t->logical_id = t->id;
+  t->name = name;
+  t->host = pthread_self();
+  t->go = true;
+  s.threads.push_back(t);
+  s.current = t;
+  new ChimeraThread(t);  // kept: the first thread's handle
+  return t;
+}
