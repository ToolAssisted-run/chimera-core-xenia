diff --git a/src/xenia/base/threading_chimera.cc b/src/xenia/base/threading_chimera.cc
new file mode 100644
index 000000000..2e3156a6c
--- /dev/null
+++ b/src/xenia/base/threading_chimera.cc
@@ -0,0 +1,968 @@
+// chimera: the threading layer on one clock.
+//
+// Upstream's threads are the host's, and time is the host's. Here every
+// thread is still a host thread - each has its own stack, and nothing about
+// the code that runs on it changes - but exactly ONE of them runs at a time.
+// The running thread holds the baton and gives it up only by asking this file
+// for something: to wait, to sleep, to yield, to end. Who gets it next is
+// decided by a rule that reads nothing from the host (round robin in order of
+// creation), and time is a number that only this file moves:
+//
+//   - a thread that waits or yields is charged a fixed cost, so that a loop
+//     that only polls still makes time pass;
+//   - whatever runs guest code charges for the instructions it ran
+//     (xe::chimera::Charge);
+//   - when nobody can run, time jumps to the earliest moment somebody can.
+//
+// So two runs of the same program do the same things in the same order at the
+// same times, whatever the host is doing.
+//
+// What a thread waits for is not kept in lists per object. A waiting thread
+// remembers what it is waiting for, and each time the baton is passed the
+// candidates are asked, in order, whether they can go. That is slower than
+// queues and it cannot get a wake-up wrong.
+#include "xenia/base/threading.h"
+
+#include <pthread.h>
+
+#include <algorithm>
+#include <cinttypes>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <mutex>
+#include <vector>
+
+#include "xenia/base/assert.h"
+#include "xenia/base/chimera_vsched.h"
+#include "xenia/base/chrono.h"
+#include "xenia/base/threading_timer_queue.h"
+
+namespace xe {
+namespace threading {
+
+namespace {
+
+constexpr int64_t kNever = INT64_MAX;
+// How many guest instructions a thread runs before the next one gets a turn.
+constexpr int64_t kSliceInstructions = 100000;
+// What asking the scheduler for anything costs the asker.
+constexpr int64_t kYieldCostNs = 1000;
+
+struct VThread;
+
+// Something a thread can wait for.
+class VWaitable {
+ public:
+  virtual ~VWaitable() = default;
+  // Could this thread take it now?
+  virtual bool Signaled(const VThread* who) const = 0;
+  // Take it.
+  virtual void Acquire(VThread* who) = 0;
+};
+
+struct VThread {
+  // the host thread underneath, and what it sleeps on while it does not hold
+  // the baton
+  pthread_t host{};
+  std::condition_variable cv;
+  bool go = false;
+
+  uint32_t id = 0;
+  uint32_t logical_id = 0;  // set_current_thread_id
+  std::string name;
+  std::function<void()> start;
+  Thread* handle = nullptr;  // the object code holds for this thread, if any
+
+  bool dead = false;
+  bool blocked = false;
+  uint32_t suspend_count = 0;
+  int32_t priority = ThreadPriority::kNormal;
+  uint64_t affinity = ~uint64_t(0);
+
+  // what it is blocked on
+  std::vector<VWaitable*> waits;
+  bool wait_all = false;
+  bool alertable = false;
+  int64_t deadline = kNever;
+  WaitResult result = WaitResult::kSuccess;
+  size_t result_index = 0;
+
+  std::deque<std::function<void()>> callbacks;  // QueueUserCallback
+  uintptr_t tls[64] = {};
+};
+
+struct Sched {
+  std::mutex host;                // guards the handing over, nothing else
+  std::vector<VThread*> threads;  // in order of creation; the dead are removed
+  VThread* current = nullptr;
+  int64_t now = 0;
+  uint64_t switches = 0;
+  uint32_t next_id = 1;
+  uint64_t tls_used = 0;
+};
+
+Sched& S() {
+  static Sched* s = new Sched();
+  return *s;
+}
+
+// What a guest instruction costs, in picoseconds. One number for the whole
+// machine: every thread's instructions move the one clock, so this is the
+// reciprocal of everything the console's six hardware threads do in a
+// second. CHIMERA_INSTRUCTION_PS changes it, for a test to see that it
+// matters.
+int64_t InstructionPicoseconds() {
+  static int64_t value = 0;
+  if (!value) {
+    const char* text = std::getenv("CHIMERA_INSTRUCTION_PS");
+    value = text && *text ? std::strtoll(text, nullptr, 10) : 250;
+    if (value <= 0) {
+      value = 250;
+    }
+  }
+  return value;
+}
+
+// Turn the instructions the running thread has executed since the last time
+// into time, and give whoever runs next a whole slice.
+int64_t g_picosecond_remainder = 0;
+void Account() {
+  const int64_t used = kSliceInstructions - chimera::g_instruction_budget;
+  chimera::g_instruction_budget = kSliceInstructions;
+  if (used > 0) {
+    const int64_t ps = used * InstructionPicoseconds() + g_picosecond_remainder;
+    S().now += ps / 1000;
+    g_picosecond_remainder = ps % 1000;
+  }
+}
+
+class ChimeraThread;
+VThread* Adopt(const char* name);
+
+// The thread that is running: the one that holds the baton. The first thread
+// of the process joins the schedule the first time it asks.
+VThread* Self() {
+  VThread* self = S().current;
+  return self ? self : Adopt("main");
+}
+
+[[noreturn]] void Deadlock() {
+  auto& s = S();
+  std::fprintf(stderr,
+               "chimera vsched: nobody can run and nobody is waiting for a "
+               "time (virtual time %" PRId64 " ns, %zu threads):\n",
+               s.now, s.threads.size());
+  for (const VThread* t : s.threads) {
+    std::fprintf(stderr, "  %3u %-28s %s%s waits=%zu%s\n", t->id,
+                 t->name.c_str(), t->blocked ? "blocked" : "ready",
+                 t->suspend_count ? " suspended" : "", t->waits.size(),
+                 t->alertable ? " alertable" : "");
+  }
+  std::fflush(stderr);
+  std::abort();
+}
+
+// Can this thread run now? A blocked thread that can is unblocked here, with
+// the result of its wait.
+bool Runnable(VThread* t) {
+  if (t->dead || t->suspend_count) {
+    return false;
+  }
+  if (!t->blocked) {
+    return true;
+  }
+  if (t->alertable && !t->callbacks.empty()) {
+    t->result = WaitResult::kUserCallback;
+    t->blocked = false;
+    return true;
+  }
+  if (!t->waits.empty()) {
+    if (t->wait_all) {
+      bool all = true;
+      for (const VWaitable* w : t->waits) {
+        all = all && w->Signaled(t);
+      }
+      if (all) {
+        for (VWaitable* w : t->waits) {
+          w->Acquire(t);
+        }
+        t->result = WaitResult::kSuccess;
+        t->result_index = 0;
+        t->blocked = false;
+        return true;
+      }
+    } else {
+      for (size_t i = 0; i < t->waits.size(); i++) {
+        if (t->waits[i]->Signaled(t)) {
+          t->waits[i]->Acquire(t);
+          t->result = WaitResult::kSuccess;
+          t->result_index = i;
+          t->blocked = false;
+          return true;
+        }
+      }
+    }
+  }
+  if (S().now >= t->deadline) {
+    t->result = WaitResult::kTimeout;
+    t->blocked = false;
+    return true;
+  }
+  return false;
+}
+
+// Who runs next: the first thread after this one, in order of creation, that
+// can. When none can, time moves to the earliest deadline and the question
+// is asked again.
+VThread* PickNext(VThread* after) {
+  auto& s = S();
+  for (;;) {
+    const size_t n = s.threads.size();
+    size_t start = 0;
+    for (size_t i = 0; i < n; i++) {
+      if (s.threads[i] == after) {
+        start = i + 1;
+        break;
+      }
+    }
+    for (size_t k = 0; k < n; k++) {
+      VThread* t = s.threads[(start + k) % n];
+      if (Runnable(t)) {
+        return t;
+      }
+    }
+    int64_t earliest = kNever;
+    for (const VThread* t : s.threads) {
+      if (!t->dead && !t->suspend_count && t->blocked) {
+        earliest = std::min(earliest, t->deadline);
+      }
+    }
+    if (earliest == kNever) {
+      Deadlock();
+    }
+    s.now = std::max(s.now, earliest);
+  }
+}
+
+// Hand the baton over and sleep until it comes back. A thread that is dead
+// does not wait for it.
+void SwitchTo(VThread* self, VThread* next) {
+  if (next == self) {
+    return;
+  }
+  auto& s = S();
+  s.switches++;
+  std::unique_lock<std::mutex> lock(s.host);
+  self->go = false;
+  s.current = next;
+  next->go = true;
+  next->cv.notify_one();
+  if (self->dead) {
+    return;
+  }
+  self->cv.wait(lock, [self] { return self->go; });
+}
+
+void RunCallbacks(VThread* self) {
+  while (!self->callbacks.empty()) {
+    auto callback = std::move(self->callbacks.front());
+    self->callbacks.pop_front();
+    callback();
+  }
+}
+
+void YieldNow(VThread* self) {
+  Account();
+  S().now += kYieldCostNs;
+  if (xe::chimera::g_trace_schedule) {
+    std::fprintf(stderr, "sched %u yield %lld %s\n", self->id,
+                 static_cast<long long>(S().now), self->name.c_str());
+  }
+  SwitchTo(self, PickNext(self));
+}
+
+// Block until something waited for can be taken, a callback is queued (when
+// alertable), or the deadline passes.
+WaitResult Block(VThread* self, VWaitable** waits, size_t count, bool wait_all,
+                 bool alertable, int64_t deadline, size_t* out_index) {
+  auto& s = S();
+  Account();
+  s.now += kYieldCostNs;
+  if (xe::chimera::g_trace_schedule) {
+    std::fprintf(stderr, "sched %u block%zu %lld %s\n", self->id, count,
+                 static_cast<long long>(s.now), self->name.c_str());
+  }
+  self->waits.assign(waits, waits + count);
+  self->wait_all = wait_all;
+  self->alertable = alertable;
+  self->deadline = deadline;
+  self->blocked = true;
+  SwitchTo(self, PickNext(self));
+  self->waits.clear();
+  self->deadline = kNever;
+  if (out_index) {
+    *out_index = self->result_index;
+  }
+  const WaitResult result = self->result;
+  if (result == WaitResult::kUserCallback) {
+    RunCallbacks(self);
+  }
+  return result;
+}
+
+int64_t DeadlineAfter(std::chrono::milliseconds timeout) {
+  if (timeout == std::chrono::milliseconds::max()) {
+    return kNever;
+  }
+  Account();
+  const int64_t ms = std::max<int64_t>(timeout.count(), 0);
+  if (ms > (kNever - S().now) / 1000000) {
+    return kNever;
+  }
+  return S().now + ms * 1000000;
+}
+
+void EndCurrent(VThread* self) {
+  auto& s = S();
+  self->dead = true;
+  self->blocked = false;
+  bool anyone = false;
+  for (const VThread* t : s.threads) {
+    anyone = anyone || !t->dead;
+  }
+  if (!anyone) {
+    // the last thread of the machine: there is nobody to hand over to
+    std::fflush(nullptr);
+    std::_Exit(0);
+  }
+  VThread* next = PickNext(self);
+  s.threads.erase(std::remove(s.threads.begin(), s.threads.end(), self),
+                  s.threads.end());
+  SwitchTo(self, next);
+}
+
+void* HostMain(void* arg) {
+  VThread* self = static_cast<VThread*>(arg);
+  {
+    std::unique_lock<std::mutex> lock(S().host);
+    self->cv.wait(lock, [self] { return self->go; });
+  }
+  self->start();
+  EndCurrent(self);
+  return nullptr;
+}
+
+// ---------------------------------------------------------------------------
+
+class ChimeraEvent final : public Event, public VWaitable {
+ public:
+  ChimeraEvent(bool manual, bool initial) : manual_(manual), set_(initial) {}
+  void* native_handle() const override {
+    return const_cast<VWaitable*>(static_cast<const VWaitable*>(this));
+  }
+  bool Signaled(const VThread*) const override { return set_; }
+  void Acquire(VThread*) override {
+    if (!manual_) {
+      set_ = false;
+    }
+  }
+  void Set() override { set_ = true; }
+  void Reset() override { set_ = false; }
+  // Whoever is waiting now goes (one of them, for an auto-reset event), and
+  // nobody who comes later does.
+  void Pulse() override {
+    set_ = true;
+    for (VThread* t : S().threads) {
+      if (!set_) {
+        break;
+      }
+      if (t->blocked &&
+          std::find(t->waits.begin(), t->waits.end(),
+                    static_cast<VWaitable*>(this)) != t->waits.end()) {
+        Runnable(t);
+      }
+    }
+    set_ = false;
+  }
+  EventInfo Query() override {
+    return EventInfo{manual_ ? 0u : 1u, set_ ? 1u : 0u};
+  }
+
+ private:
+  bool manual_;
+  bool set_;
+};
+
+class ChimeraSemaphore final : public Semaphore, public VWaitable {
+ public:
+  ChimeraSemaphore(int initial, int maximum) : count_(initial), max_(maximum) {}
+  void* native_handle() const override {
+    return const_cast<VWaitable*>(static_cast<const VWaitable*>(this));
+  }
+  bool Signaled(const VThread*) const override { return count_ > 0; }
+  void Acquire(VThread*) override { count_--; }
+  bool Release(int release_count, int* out_previous_count) override {
+    if (release_count <= 0 || count_ + release_count > max_) {
+      return false;
+    }
+    if (out_previous_count) {
+      *out_previous_count = count_;
+    }
+    count_ += release_count;
+    return true;
+  }
+
+ private:
+  int count_;
+  int max_;
+};
+
+class ChimeraMutant final : public Mutant, public VWaitable {
+ public:
+  explicit ChimeraMutant(bool initial_owner) {
+    if (initial_owner) {
+      owner_ = Self();
+      count_ = 1;
+    }
+  }
+  void* native_handle() const override {
+    return const_cast<VWaitable*>(static_cast<const VWaitable*>(this));
+  }
+  bool Signaled(const VThread* who) const override {
+    return owner_ == nullptr || owner_ == who;
+  }
+  void Acquire(VThread* who) override {
+    owner_ = who;
+    count_++;
+  }
+  bool Release() override {
+    if (owner_ != Self() || count_ == 0) {
+      return false;
+    }
+    if (--count_ == 0) {
+      owner_ = nullptr;
+    }
+    return true;
+  }
+
+ private:
+  const VThread* owner_ = nullptr;
+  uint32_t count_ = 0;
+};
+
+class ChimeraTimer final : public Timer, public VWaitable {
+ public:
+  explicit ChimeraTimer(bool manual) : manual_(manual) {}
+  ~ChimeraTimer() override { Cancel(); }
+  void* native_handle() const override {
+    return const_cast<VWaitable*>(static_cast<const VWaitable*>(this));
+  }
+  bool Signaled(const VThread*) const override { return signaled_; }
+  void Acquire(VThread*) override {
+    if (!manual_) {
+      signaled_ = false;
+    }
+  }
+
+  bool SetOnceAfter(xe::chrono::hundrednanoseconds rel_time,
+                    std::function<void()> opt_callback) override {
+    return Arm(chimera::SteadyNow() + rel_time, GClock_::duration::zero(),
+               std::move(opt_callback));
+  }
+  bool SetOnceAt(WClock_::time_point due_time,
+                 std::function<void()> opt_callback) override {
+    return Arm(FromSystem(due_time), GClock_::duration::zero(),
+               std::move(opt_callback));
+  }
+  bool SetOnceAt(GClock_::time_point due_time,
+                 std::function<void()> opt_callback) override {
+    return Arm(due_time, GClock_::duration::zero(), std::move(opt_callback));
+  }
+  bool SetRepeatingAfter(xe::chrono::hundrednanoseconds rel_time,
+                         std::chrono::milliseconds period,
+                         std::function<void()> opt_callback) override {
+    return Arm(chimera::SteadyNow() + rel_time, period,
+               std::move(opt_callback));
+  }
+  bool SetRepeatingAt(WClock_::time_point due_time,
+                      std::chrono::milliseconds period,
+                      std::function<void()> opt_callback) override {
+    return Arm(FromSystem(due_time), period, std::move(opt_callback));
+  }
+  bool SetRepeatingAt(GClock_::time_point due_time,
+                      std::chrono::milliseconds period,
+                      std::function<void()> opt_callback) override {
+    return Arm(due_time, period, std::move(opt_callback));
+  }
+  bool Cancel() override {
+    if (auto item = item_.lock()) {
+      item->Disarm();
+    }
+    item_.reset();
+    return true;
+  }
+
+ private:
+  // A moment on the system's clock, as a moment on the steady one: both are
+  // this file's time, so the distance from now is exact.
+  static GClock_::time_point FromSystem(WClock_::time_point due) {
+    return chimera::SteadyNow() +
+           std::chrono::duration_cast<GClock_::duration>(due - WClock_::now());
+  }
+  bool Arm(GClock_::time_point due, GClock_::duration period,
+           std::function<void()> callback) {
+    Cancel();
+    signaled_ = false;
+    callback_ = std::move(callback);
+    auto fire = [this](void*) {
+      signaled_ = true;
+      if (callback_) {
+        callback_();
+      }
+    };
+    item_ = period == GClock_::duration::zero()
+                ? QueueTimerOnce(fire, nullptr, due)
+                : QueueTimerRecurring(fire, nullptr, due, period);
+    return true;
+  }
+
+  bool manual_;
+  bool signaled_ = false;
+  std::function<void()> callback_;
+  std::weak_ptr<TimerQueueWaitItem> item_;
+};
+
+class ChimeraThread final : public Thread, public VWaitable {
+ public:
+  explicit ChimeraThread(VThread* thread) : thread_(thread) {
+    thread_->handle = this;
+    name_ = thread_->name;
+  }
+  ~ChimeraThread() override {
+    if (thread_->handle == this) {
+      thread_->handle = nullptr;
+    }
+  }
+  void* native_handle() const override {
+    return const_cast<VWaitable*>(static_cast<const VWaitable*>(this));
+  }
+  // a thread is waited for until it has ended
+  bool Signaled(const VThread*) const override { return thread_->dead; }
+  void Acquire(VThread*) override {}
+
+  uint32_t system_id() const override { return thread_->id; }
+  void set_name(std::string name) override {
+    thread_->name = name;
+    Thread::set_name(std::move(name));
+  }
+  int32_t priority() override { return thread_->priority; }
+  void set_priority(int32_t new_priority) override {
+    thread_->priority = new_priority;
+  }
+  uint64_t affinity_mask() override { return thread_->affinity; }
+  void set_affinity_mask(uint64_t new_affinity_mask) override {
+    thread_->affinity = new_affinity_mask;
+  }
+  void QueueUserCallback(std::function<void()> callback) override {
+    thread_->callbacks.push_back(std::move(callback));
+  }
+  bool Resume(uint32_t* out_previous_suspend_count) override {
+    if (out_previous_suspend_count) {
+      *out_previous_suspend_count = thread_->suspend_count;
+    }
+    if (thread_->suspend_count) {
+      thread_->suspend_count--;
+    }
+    return true;
+  }
+  bool Suspend(uint32_t* out_previous_suspend_count) override {
+    if (out_previous_suspend_count) {
+      *out_previous_suspend_count = thread_->suspend_count;
+    }
+    thread_->suspend_count++;
+    if (thread_ == Self()) {
+      // suspended by itself: it stops here, until somebody resumes it
+      SwitchTo(thread_, PickNext(thread_));
+    }
+    return true;
+  }
+  void Terminate(int exit_code) override {
+    if (thread_ == Self()) {
+      Thread::Exit(exit_code);
+    }
+    // Its host thread is asleep waiting for the baton and is never given it
+    // again.
+    auto& s = S();
+    thread_->dead = true;
+    s.threads.erase(std::remove(s.threads.begin(), s.threads.end(), thread_),
+                    s.threads.end());
+  }
