+// table just below the memory base is indexed by the address's top byte.
+// dst is the only register written, and must not be `guest`.
+static void EmitFoldedAddress(X64Emitter& e, const Xbyak::Reg32& dst,
+                              const Xbyak::Reg32& guest, int32_t offset) {
+  if (offset) {
+    e.lea(dst, e.ptr[guest + offset]);
+  } else {
+    e.mov(dst, guest);
+  }
+  e.shr(dst, 24);
+  e.mov(dst, e.dword[e.GetMembaseReg() + dst.cvt64() * 4 -
+                     xe::chimera::kFoldTableBelow]);
+  e.add(dst, guest);
+  if (offset) {
+    e.add(dst, offset);
+  }
+}
+#endif
