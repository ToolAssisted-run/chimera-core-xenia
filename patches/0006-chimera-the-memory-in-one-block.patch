+// chimera: see the header
+namespace {
+bool g_observing = false;
+std::vector<void*>* g_observer_opened = nullptr;
+
+// A read by the observer of a page nobody may read: open it, remember it.
+bool ObserverOpens(void* host_address, bool is_write) {
+  if (!g_observing || is_write) {
+    return false;
+  }
+  void* page = reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(host_address) &
+                                       ~uintptr_t(0xFFF));
+  if (!xe::memory::Protect(page, 0x1000, xe::memory::PageAccess::kReadOnly,
+                           nullptr)) {
+    return false;
+  }
+  g_observer_opened->push_back(page);
+  return true;
+}
+}  // namespace
+
+void MMIOHandler::BeginObserving() {
+  if (!g_observer_opened) {
+    g_observer_opened = new std::vector<void*>();
+    // no allocation where the fault is handled
+    g_observer_opened->reserve(0x100000);
+  }
+  g_observing = true;
+}
+
+void MMIOHandler::EndObserving() {
+  g_observing = false;
+  for (void* page : *g_observer_opened) {
+    xe::memory::Protect(page, 0x1000, xe::memory::PageAccess::kNoAccess,
+                        nullptr);
+  }
+  g_observer_opened->clear();
+}
+
+bool MMIOHandler::HandleWatchedAccess(void* host_address, bool is_write) {
+  if (reinterpret_cast<uint8_t*>(host_address) < virtual_membase_ ||
+      reinterpret_cast<uint8_t*>(host_address) > memory_end_ ||
+      !access_violation_callback_) {
+    return false;
+  }
+  if (ObserverOpens(host_address, is_write)) {
+    return true;
+  }
+  auto lock = global_critical_region_.Acquire();
+  return access_violation_callback_(std::move(lock),
+                                    access_violation_callback_context_,
+                                    host_address, is_write);
+}
