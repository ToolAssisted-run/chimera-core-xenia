+// chimera: the console's memory without views.
+//
+// Upstream maps one shared file at several places: the 512 MiB of physical
+// memory are seen at 0xA0000000, at 0xC0000000, at 0xE0000000 (4 KiB on) and
+// from 0x7F000000 (its first 16 MiB), and the code range at 0x80000000 is
+// seen again at 0x90000000. A sandboxed guest has anonymous memory only: a
+// page is at one address.
+//
+// So here the emulated address space is ONE block of 4 GiB, each alias is
+// FOLDED onto the range it is an alias of before it is used, and physical
+// memory is the block's own 0xA0000000 range. The fold is a table of 256
+// 32-bit numbers, one for each top byte of an address, kept just below the
+// block: folded = address + table[address >> 24], in 32 bits. The recompiler
+// does that in four instructions with one register (x64_seq_memory.cc), and
+// everything else through Memory::TranslateVirtual.
+#ifndef XENIA_BASE_CHIMERA_FLATMEM_H_
+#define XENIA_BASE_CHIMERA_FLATMEM_H_
+
+#include <cstdint>
+
+namespace xe {
+namespace chimera {
+
+// Where physical memory is in the block.
+constexpr uint32_t kPhysicalBase = 0xA0000000u;
+// The table's place: this many bytes below the block.
+constexpr uint32_t kFoldTableBelow = 0x400;
+
+// What is added to an address whose top byte is this one.
+constexpr uint32_t FoldDelta(uint32_t top_byte) {
+  return top_byte == 0x7F                     ? kPhysicalBase - 0x7F000000u
+         : top_byte >= 0x90 && top_byte <= 0x9F ? 0x80000000u - 0x90000000u
+         : top_byte >= 0xC0 && top_byte <= 0xDF ? kPhysicalBase - 0xC0000000u
+         : top_byte >= 0xE0                     ? kPhysicalBase + 0x1000u - 0xE0000000u
+                                                : 0u;
+}
+
+constexpr uint32_t FoldAddress(uint32_t address) {
+  return address + FoldDelta(address >> 24);
+}
+
+// ---------------------------------------------------------------------------
+// The recompiler's own things, by the same base.
+//
+// Upstream's x64 backend keeps its table of function addresses at host
+// address 0x80000000, its code at 0xA0000000, its constants at 0x20000000 and
+// its trampolines somewhere below 2 GiB, and reaches all of them by 32-bit
+// absolute addresses. A guest has nothing below 4 GiB. Here they are at
+// fixed places relative to the block, and generated code reaches them from
+// the register that always holds the block's address:
+//
+//   base - kBelowBlock      room below the block
+//   base - kConstDataBelow    the recompiler's constants
+//   base - kFoldTableBelow    the fold table
+//   base + 0 .. 4 GiB       the console's address space, of which the top
+//                           GiB is never touched (it is folded away), so:
+//   base + kTrampolineBase    host trampolines a guest can call
+//   base + kCodeBase          generated code
+//   base + kIndirectionDisp + g   the table's slot for guest address g, which
+//                           begins in the block's last 64 KiB and runs
+//                           kAfterBlock past its end
+//
+// The block's address is a multiple of 4 GiB. So the low 32 bits of any
+// address in it are its distance from the base - which is what the backend
+// already keeps wherever it keeps "a 32-bit host address".
+constexpr uint64_t kBelowBlock = 0x10000;
+constexpr uint32_t kConstDataBelow = 0x8000;
+constexpr uint32_t kConstDataRoom = kConstDataBelow - 0x1000;
+constexpr uint32_t kTrampolineBase = 0xC0100000u;
+constexpr uint32_t kCodeBase = 0xC1000000u;
+constexpr uint32_t kIndirectionDisp = 0x7FFF0000u;
+constexpr uint64_t kAfterBlock = 0x20000000ull;
+
+// The block, once Memory has made it; null before.
+uint8_t* FlatBase();
+void SetFlatBase(uint8_t* base);
+
+}  // namespace chimera
+}  // namespace xe
+
+#endif  // XENIA_BASE_CHIMERA_FLATMEM_H_
