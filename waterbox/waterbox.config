 "suggestSettings": true,
 "_suggestSettings_note": "SuggestSettings looks the game up by its title id in Xenia Manager's optimized settings (github.com/xenia-manager/optimized-settings, a port of A1eNaz's wiki), which this core carries (driver/optimized_settings.inc), without starting it: the New Project window puts the values on its settings page, where each can still be changed, and says where they come from or that the game is not in the list.",
 "settings": [
  {
   "name": "renderer",
   "display": "setting.renderer",
   "type": "enum",
   "options": [
    "vulkan-hw",
    "null"
   ],
   "default": "vulkan-hw",
   "description": "setting.renderer.about"
  },
  {
   "name": "pads",
   "display": "setting.pads",
   "type": "enum",
   "options": [
    "1",
    "2",
    "3",
    "4"
   ],
   "default": "1",
   "description": "setting.pads.about"
  },
  {
   "name": "cpu_speed",
   "display": "setting.cpu_speed",
   "type": "enum",
   "options": [
    "500",
    "1000",
    "2000",
    "4000"
   ],
   "default": "2000",
   "description": "setting.cpu_speed.about"
  },
  {
   "name": "arcade_license",
   "display": "setting.arcade_license",
   "type": "enum",
   "options": [
    "full",
    "trial"
   ],
   "default": "full",
   "description": "setting.arcade_license.about"
  },
  {
   "name": "clear_memory_page_state",
   "display": "setting.clear_memory_page_state",
   "type": "bool",
   "default": false,
   "description": "setting.clear_memory_page_state.about"
  },
  {
   "name": "occlusion_query_fake_lower_threshold",
