 "extensions": {
  ".iso": "X360"
 },
 "suggestSettings": true,
 "_suggestSettings_note": "SuggestSettings looks the game up by its title id in Xenia Manager's optimized settings (github.com/xenia-manager/optimized-settings, a port of A1eNaz's wiki), which this core carries (driver/optimized_settings.inc), without starting it: the New Project window puts the values on its settings page, where each can still be changed, and says where they come from or that the game is not in the list.",
 "settings": [
  {
   "name": "renderer",
   "display": "Renderer",
   "type": "enum",
   "options": [
    "vulkan-hw",
    "null"
   ],
   "default": "vulkan-hw",
   "description": "How the picture is drawn. \"vulkan-hw\" is Xenia's Vulkan renderer on your computer's graphics card, through the Vulkan bridge. \"null\" draws nothing: the game runs exactly the same, with a black picture, and needs no graphics card. Nothing the graphics card draws goes back into the console's memory, so a movie made with one plays back with the other."
  },
  {
   "name": "pads",
   "display": "Controllers",
   "type": "enum",
   "options": [
    "1",
    "2",
    "3",
    "4"
   ],
   "default": "1",
   "description": "How many controllers are plugged in, from the first port. A game sees the other ports as empty."
  },
  {
   "name": "cpu_speed",
   "display": "CPU Speed",
   "type": "enum",
   "options": [
    "500",
    "1000",
    "2000",
    "4000"
   ],
   "default": "2000",
   "description": "How fast the console's processor is: how many million instructions it runs in a second, counting all six of its threads together. 2000, the default, is the closest to a real console, and the speed games are made for: some do not finish loading at all below it (Prince of Persia Classic stays on \"Now loading...\" for ever at 500 and at 1000). Many games keep the processor busy even while they wait for the next frame, so your computer has to run about this many instructions for every second of the game, and it manages a few hundred million: at 2000 such a game runs at about a quarter of full speed, at 1000 half, at 500 near full speed. 500 and 1000 suit a game that loads at them, when speed matters more while making a TAS; 4000 is for a game that is still too slow. This setting is part of the console: a movie made at one speed does not play back at another."
  },
  {
   "name": "arcade_license",
   "display": "Arcade Games",
   "type": "enum",
   "options": [
    "full",
    "trial"
   ],
   "default": "full",
   "description": "For Xbox Live Arcade games only. An Arcade game and its free trial are the same file: the game asks the console whether it was bought. \"full\" answers yes, and the whole game can be played. \"trial\" answers no, and the game is its trial version. A game from a disc image is not affected. This setting is part of the console: a movie made with one does not play back with the other."
  },
  {
   "name": "clear_memory_page_state",
   "display": "Clear Memory Page State",
   "type": "bool",
   "default": false,
   "description": "Xenia's clear_memory_page_state. Xenia keeps track of which pages of the console's memory the graphics chip wrote; this marks them again every frame, so that the next draw sees what was written there. It fixes models that are missing or warped in some games, Team Ninja's among them, and costs some speed. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "occlusion_query_fake_lower_threshold",
   "display": "Occlusion Answer, Lowest",
   "type": "int",
   "default": 80,
   "min": -1,
   "max": 10000,
   "description": "Xenia's occlusion_query_fake_lower_threshold. A game asks how many pixels of something were visible (an occlusion query) for lens flares, culling and the like. This core never asks the graphics card, so that the console is the same on every computer: it answers with a made-up count between this number and the next setting's. -1 answers nothing, and some games then wait for good. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "occlusion_query_fake_upper_threshold",
   "display": "Occlusion Answer, Highest",
   "type": "int",
   "default": 100,
   "min": -1,
   "max": 10000,
   "description": "Xenia's occlusion_query_fake_upper_threshold: the highest made-up count, see Occlusion Answer, Lowest. Keep it at or above that one. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "depth_bias_shader_offset",
   "display": "Depth Bias in Shader",
   "type": "bool",
   "default": false,
   "description": "Xenia's depth_bias_shader_offset. Decals that a game draws a tiny distance in front of a surface are moved by the shader rather than by the graphics card's fixed depth bias, which cannot reproduce such small values. It fixes flickering decals. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It changes only the picture: nothing the graphics card draws goes back into the console's memory, so a movie plays back with either value."
  },
  {
   "name": "gamma_render_target_as_unorm16",
   "display": "Gamma Targets at 16 Bits",
   "type": "bool",
   "default": true,
   "description": "Xenia's gamma_render_target_as_unorm16. Where the graphics card cannot blend the console's gamma-encoded 8-bit targets directly, they are kept at 16 bits a channel so that blending is right; off keeps them at 8, which is faster and less exact. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It changes only the picture: nothing the graphics card draws goes back into the console's memory, so a movie plays back with either value."
  },
  {
   "name": "gpu_allow_invalid_upload_range",
   "display": "Allow Reads of Closed Pages",
   "type": "bool",
   "default": false,
   "description": "Xenia's gpu_allow_invalid_upload_range: the graphics chip may read from pages of the console's memory that are marked as not to be read. Some games need it to draw at all. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "force_depth_clamp",
   "display": "Clamp Depth",
   "type": "bool",
   "default": false,
   "description": "Xenia's force_depth_clamp: what lies in front of the near plane or behind the far one is clamped to it rather than cut away, where the game asks for clipping. The graphics card must support depth clamping. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It changes only the picture: nothing the graphics card draws goes back into the console's memory, so a movie plays back with either value."
  },
  {
   "name": "render_target_path_vulkan",
   "display": "Render Targets",
   "type": "enum",
   "options": [
    "fbo",
    "fsi"
   ],
   "default": "fbo",
   "description": "Xenia's render_target_path_vulkan: how the console's render targets are drawn. \"fbo\" uses the graphics card's own targets and blending, copying between them where needed: fast, and less exact with some pixel formats. \"fsi\" does the console's blending and depth tests in the pixel shader, which is exact but slower and needs a card with fragment shader interlock; without it Xenia uses \"fbo\". It changes only the picture: nothing the graphics card draws goes back into the console's memory, so a movie plays back with either value."
  },
  {
   "name": "break_on_unimplemented_instructions",
   "display": "Stop on Unknown Instructions",
   "type": "bool",
   "default": true,
   "description": "Xenia's break_on_unimplemented_instructions. When the game's code has an instruction Xenia cannot translate, the game stops there. Off, the instruction is passed over, and some games then run on. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "protect_zero",
   "display": "Protect Address Zero",
   "type": "bool",
   "default": true,
   "description": "Xenia's protect_zero: the console's first page of memory can be neither read nor written, as on the console, so a game that reads through a null pointer stops there. Some games read it by mistake and run only with this off. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "ignore_offset_for_ranged_allocations",
   "display": "Ranged Allocations at the Range's Start",
   "type": "bool",
   "default": false,
   "description": "Xenia's ignore_offset_for_ranged_allocations. Memory a game asks for within a given range starts exactly at the range's lowest address, without the 4 KiB Xenia otherwise leaves; some games check that it does. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "scribble_heap",
   "display": "Fill New Memory",
   "type": "bool",
   "default": false,
   "description": "Xenia's scribble_heap: memory a game is given is filled first, with the byte of Fill Value. Some games that read memory before writing it run only so. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "scribble_heap_value",
   "display": "Fill Value",
   "type": "int",
   "default": 0,
   "min": 0,
   "max": 255,
   "description": "Xenia's scribble_heap_value: the byte Fill New Memory writes, 1 to 255. 0 fills it with numbers from the console's own sequence of random numbers, the same on every run. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "xma_decoder",
   "display": "Audio Decoder",
   "type": "enum",
   "options": [
    "new",
    "old",
    "master",
    "fake"
   ],
   "default": "new",
   "description": "Xenia's xma_decoder: which of Xenia's decoders turns the console's compressed sound (XMA) into samples. \"new\" is the current one, \"old\" the one before it, \"master\" the one of the original Xenia, \"fake\" decodes nothing and is silent. Some games play their sound right only with \"old\". Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "use_dedicated_xma_thread",
   "display": "Audio Decoder Thread",
   "type": "bool",
   "default": true,
   "description": "Xenia's use_dedicated_xma_thread: the compressed sound is decoded on a thread of its own. Off, it is decoded when the game asks, which fixes the sound of some games. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "cl",
   "display": "Game Command Line",
   "type": "string",
   "default": "",
   "description": "Xenia's cl: words handed to the game as its command line, as a development kit could. Gears of War 2 and 3 skip their opening films with \"-NoStartupMovies\". Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "launch_module",
   "display": "Program on the Disc",
   "type": "string",
   "default": "",
   "description": "Xenia's launch_module: the program on the disc that is started, instead of default.xex. Assassin's Creed III and IV are started from \"scimitar_final.xex\". Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "mount_scratch",
   "display": "Scratch Partition",
   "type": "bool",
   "default": false,
   "description": "Xenia's mount_scratch: the console's scratch partition is there for the game to use, as on a console with a hard drive. Some games keep something on it, such as an instant replay, or will not start without it. Xenia Manager's optimized settings suggest it for some games, and the New Project window sets it when it knows the game. It is part of the console: a movie made with one value does not play back with the other."
  },
  {
   "name": "readback_resolve",
   "display": "Readback Resolve",
   "type": "enum",
   "options": [
    "none",
    "fast",
    "full"
   ],
   "default": "none",
   "description": "Xenia's readback_resolve: whether what a game draws into a texture is copied back into the console's memory, for the games that read it there (Max Payne 3's picture is black without it). \"none\" copies nothing, \"full\" waits for the graphics card at every copy and is slow, \"fast\" reads the copy made a frame before; in this core \"fast\" also waits for that copy, so a run is the same every time on one graphics card. It makes the console's memory hold what your graphics card draws: a movie made with it may play back differently on another graphics card or driver, and does not play back with the null renderer. The New Project window never sets it by itself; Xenia Manager's optimized settings name it in the note when they use it for the game (user-decided, 2026-10-16)."
  }
 ]
}
