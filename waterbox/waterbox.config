   "default": 80,
   "min": -1,
   "max": 10000,
   "description": "setting.occlusion_query_fake_lower_threshold.about"
  },
  {
   "name": "occlusion_query_fake_upper_threshold",
   "display": "setting.occlusion_query_fake_upper_threshold",
   "type": "int",
   "default": 100,
   "min": -1,
   "max": 10000,
   "description": "setting.occlusion_query_fake_upper_threshold.about"
