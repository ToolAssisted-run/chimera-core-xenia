 "extensions": {
  ".iso": "X360"
 },
 "settings": [
  {
   "name": "renderer",
   "display": "Renderer",
   "type": "enum",
   "options": [
    "vulkan-hw",
    "null"
   ],
   "default": "vulkan-hw",
   "description": "How the picture is drawn. \"vulkan-hw\" is Xenia's Vulkan renderer on your computer's graphics card, through the Vulkan bridge. \"null\" draws nothing: the game runs exactly the same, with a black picture, and needs no graphics card. Nothing the graphics card draws goes back into the console's memory, so a movie made with one plays back with the other."
  },
  {
   "name": "pads",
   "display": "Controllers",
   "type": "enum",
   "options": [
    "1",
    "2",
    "3",
    "4"
   ],
   "default": "1",
   "description": "How many controllers are plugged in, from the first port. A game sees the other ports as empty."
  },
  {
   "name": "cpu_speed",
   "display": "CPU Speed",
   "type": "enum",
   "options": [
    "500",
    "1000",
    "2000",
    "4000"
   ],
   "default": "500",
   "description": "How fast the console's processor is: how many million instructions it runs in a second, counting all six of its threads together. 2000 is the closest to a real console. 500 is the default because it gives a better experience when making a TAS: many games keep the processor busy even while they wait for the next frame, so your computer has to run about this many instructions for every second of the game, and it manages a few hundred million. At 500 such a game runs near full speed; at 1000, 2000 and 4000 it runs about two, four and eight times slower. A slower processor makes loading take longer, and a demanding game may drop frames. This setting is part of the console: a movie made at one speed does not play back at another."
  }
 ]
}
